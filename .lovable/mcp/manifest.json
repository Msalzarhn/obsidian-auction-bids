            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Bid amount in HNL (Lempiras). Must beat the current highest bid."
            }
          },
          "required": [
            "item_id",
            "amount"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
